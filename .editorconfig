# QRun-IO qbit .editorconfig: the Kingsrook layout (3-space indentation, never tabs).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 3
tab_width = 3

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.{cmd,bat}]
end_of_line = crlf
